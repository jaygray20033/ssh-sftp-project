# ShellDeck — configuration for `docker compose up` (copy to .env and edit).
# Every value marked REQUIRED must be filled in; compose refuses to start otherwise.

# ---- Web ----
# Host port for the web container (use e.g. 8081 if a host nginx already owns 80)
WEB_PORT=80
# The URL users type in the browser. Used for CORS and links in e-mails.
CLIENT_URL=http://localhost
CLIENT_ORIGINS=http://localhost
# Refresh-token cookie "Secure" flag. Set to true when served over HTTPS (production!).
COOKIE_SECURE=false
# Reverse proxies in front of the API: 1 (web container only) or 2 (host nginx in front of it)
TRUST_PROXY=1
APP_NAME=ShellDeck
# Swagger UI at /docs is served by the API container (not proxied by nginx); keep off in production.
ENABLE_DOCS=false

# ---- Database ----
POSTGRES_USER=shelldeck
POSTGRES_DB=shelldeck
# REQUIRED. URL-safe:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Secrets (all REQUIRED) ----
# base64 of 32 bytes (encrypts SSH credentials):  openssl rand -base64 32
ENCRYPTION_KEY=
# >= 32 chars each:  openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
REFRESH_TOKEN_HASH_SECRET=
AUTH_TOKEN_HASH_SECRET=

# ---- Google sign-in (optional, leave empty to disable) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/v1/auth/google/callback

# ---- E-mail (verify e-mail / reset password) ----
EMAIL_PROVIDER=nodemailer
MAIL_FROM=noreply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# ---- Terminal (WebSocket SSH) ----
# Max concurrent terminal sessions per user
MAX_SESSIONS_PER_USER=5
# Close a session after this many minutes without input
SESSION_IDLE_TIMEOUT_MIN=30

# ---- SSRF guard ----
# Blocks private/loopback SSH targets (127.0.0.1, 10/8, 192.168/16, cloud metadata...)
# Set true ONLY when self-hosting inside a LAN and connecting to LAN machines.
ALLOW_PRIVATE_HOSTS=false
# Comma-separated allowlist. When set, ONLY these hosts may be connected to.
ALLOWED_HOSTS=

# ---- Host health ----
# Seconds between background TCP checks of every host's SSH port
HOST_HEALTH_CHECK_INTERVAL_SEC=60

# ---- Session recording (opt-in per host, asciicast v2) ----
# Folder where .cast recordings are stored. Mount a volume if you want them to survive rebuilds.
RECORDINGS_DIR=recordings
# Stop writing a recording when it grows beyond this many megabytes
RECORDING_MAX_SIZE_MB=20
# Delete recording files older than this many days
RECORDING_RETENTION_DAYS=7

# ---- SFTP ----
# Max upload size in megabytes
SFTP_MAX_UPLOAD_MB=100

# ---- Audit logs ----
# Delete session logs older than this many days
SESSION_LOG_RETENTION_DAYS=90

# ---- Plugins (docs/plugin-guide.md) ----
# Folder the API container scans at start-up. Compose mounts the repository ./plugins here read-only.
# Keep /app/plugins unless you mount your own plugin folder.
PLUGINS_DIR=/app/plugins
# Settings for the sample plugin: POST session events to this URL (empty = do nothing).
EXAMPLE_WEBHOOK_URL=
