# ShellDeck API — local development (copy to `.env`).
# Docker compose users: configure infra/docker/.env instead (see README).

PORT=8080
NODE_ENV=development
APP_NAME=ShellDeck

# Browser URL(s) of the web app (CORS + links in e-mails)
CLIENT_URL=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (0 in dev, 1 behind nginx)
TRUST_PROXY=0
# Refresh-token cookie "Secure" flag. Default: true in production, false otherwise.
# COOKIE_SECURE=false

# Database — matches infra/docker/docker-compose.dev.yml
DATABASE_URL=postgres://shelldeck:shelldeck@localhost:5432/shelldeck
DATABASE_SSL=false
# Run pending migrations when the API starts (compose sets this to true)
AUTO_MIGRATE=false

# Credential encryption key: base64 of 32 random bytes.  openssl rand -base64 32
# DEV VALUE ONLY — never reuse in production.
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# JWT / token secrets (>= 32 chars each).  openssl rand -base64 48
# DEV VALUES ONLY — never reuse in production.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-change-me-012345
REFRESH_TOKEN_HASH_SECRET=dev-only-refresh-hash-secret-change-me-0123
AUTH_TOKEN_HASH_SECRET=dev-only-auth-token-hash-secret-change-me-01
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
MAX_SESSION_LIFETIME_IN=2592000

# Google sign-in (optional: leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# E-mail (verify e-mail / reset password): nodemailer (SMTP) or resend
EMAIL_PROVIDER=nodemailer
MAIL_FROM=noreply@example.com
# Display name of the sender. Empty falls back to APP_NAME.
MAIL_FROM_NAME=
SMTP_HOST=smtp.gmail.com
# 465 sends over implicit TLS, any other port uses STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
VERIFY_EMAIL_EXPIRE_MINUTES=10
RESET_PASSWORD_EXPIRE_MINUTES=5

# Swagger UI at /docs
ENABLE_DOCS=true

# Terminal (WebSocket SSH)
# Max concurrent terminal sessions per user
MAX_SESSIONS_PER_USER=5
# Close a session after this many minutes without input
SESSION_IDLE_TIMEOUT_MIN=30

# SSRF guard: block private/loopback SSH targets (127.0.0.1, 10/8, 192.168/16, ...)
# Set true when self-hosting inside a LAN (e.g. the dev compose SSH server).
ALLOW_PRIVATE_HOSTS=false
# Comma-separated allowlist. When set, ONLY these hosts may be connected to.
# Example: ALLOWED_HOSTS=server1.example.com,192.0.2.10
ALLOWED_HOSTS=

# SFTP
# Max upload size in megabytes
SFTP_MAX_UPLOAD_MB=100

# Audit logs (session history)
# Delete session logs older than this many days
SESSION_LOG_RETENTION_DAYS=90
