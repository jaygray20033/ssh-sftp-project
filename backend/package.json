{
  "name": "shelldeck-api",
  "version": "0.1.0",
  "description": "ShellDeck API - SSH & SFTP in the browser",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "dev:ts": "node -r @swc-node/register --watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node -e \"require('fs').cpSync('src/assets', 'dist/assets', {recursive: true})\"",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/databases/cli-data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/databases/cli-data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/databases/cli-data-source.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "cd .. && husky backend/.husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "axios": "^1.15.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mjml": "^5.1.0",
    "multer": "2.0.2",
    "node-cache": "^5.1.2",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pug": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "ssh2": "^1.17.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategies": "^4.1.0",
    "ws": "^8.22.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.18",
    "@swc/helpers": "^0.5.19",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/mjml": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pug": "^2.0.10",
    "@types/ssh2": "^1.15.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
